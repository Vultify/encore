    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
